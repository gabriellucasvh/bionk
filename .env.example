# ==========================================
# CONFIGURAÇÃO DE AMBIENTE - BIONK VPS
# ==========================================
# Copiar para .env.production e preencher os valores reais
# NUNCA commitar .env.production no Git

# Ambiente
NODE_ENV=production

# URL da Aplicação e Domínio (DuckDNS + Let's Encrypt HTTPS)
NEXT_PUBLIC_APP_URL="https://bionk.duckdns.org"
NEXT_PUBLIC_BASE_URL="https://bionk.duckdns.org"
NEXTAUTH_URL="https://bionk.duckdns.org"
# Gere com: openssl rand -hex 32
NEXTAUTH_SECRET="gere_um_secret_seguro_com_openssl_rand_hex_32"

# Banco de Dados (PostgreSQL no Docker — hostname = nome do service no docker-compose)
POSTGRES_USER="bionkuser"
POSTGRES_PASSWORD="senha_forte_postgres_aqui"
POSTGRES_DB="bionk"
# sslmode=disable porque a conexao e interna (mesma rede Docker)
DATABASE_URL="postgresql://bionkuser:senha_forte_postgres_aqui@postgres:5432/bionk?sslmode=disable"

# Cache & Queues (Redis no Docker — hostname = nome do service no docker-compose)
REDIS_PASSWORD="senha_forte_redis_aqui"
REDIS_URL="redis://:senha_forte_redis_aqui@redis:6379"

# Envio de E-mails (Resend)
RESEND_API_KEY="re_sua_chave_resend_aqui"
# ATENCAO: bionk.me nao esta mais ativo. Use um dominio verificado no Resend
# ou o email padrao de sandbox do Resend (onboarding@resend.dev)
RESEND_FROM_EMAIL="Bionk <onboarding@resend.dev>"

# Google OAuth
GOOGLE_CLIENT_ID="seu_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-sua_secret_aqui"

# Webhooks / Discord Notificações (Opcional)
DISCORD_WEBHOOK_URL=""
# Gere com: openssl rand -hex 32
CRON_SECRET="gere_uma_chave_secreta_para_cron"

# Armazenamento de Mídia (Cloudinary)
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="sua_api_key"
CLOUDINARY_API_SECRET="sua_api_secret"

# Pagamentos (Stripe)
# AVISO: Stripe requer HTTPS em producao. Funcionalidade desabilitada sem dominio.
# Configure quando tiver dominio + SSL.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# HMAC para tokens
TOKEN_HMAC_SECRET="gere_com_openssl_rand_hex_32"

# APIs de Mídia
PEXELS_API_KEY=""
COVERR_API_KEY=""

# Ingestão de eventos
INGEST_SHARDS=8
INGEST_MAX_BATCH=1000
INGEST_MODE=sync
